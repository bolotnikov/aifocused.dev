---
import { render, type CollectionEntry } from 'astro:content';
import Footer from '../components/common/Footer.astro';
import Header from '../components/common/Header.astro';
import { Locale } from '../i18n/Locale';
import Layout from '../layouts/Layout.astro';

interface Props {
	article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, subtitle, description, pubDate, cover } = article.data;
const { Content, headings } = await render(article);
const sections = headings.filter(({ depth }) => depth === 2);
const i18n = Locale.forPath(Astro.url.pathname);
const contentsLabel = i18n.t('article.contents');
const dateFormat = new Intl.DateTimeFormat(i18n.dateLocale, { dateStyle: 'long', timeZone: 'UTC' });
---

<Layout title={`${title} — AIFocused.dev`} description={description} image={cover?.src} ogType="article">
	<Header current="article" />
	<main class="page-main article-page">
		<article class:list={['container', 'article-layout', { 'article-layout--with-contents': sections.length > 0 }]}>
			<header class="article-page__header">
				<a class="article-page__back" href={i18n.path('/')}>{i18n.t('Back to home')}</a>
				<h1 class="article-page__title">{title}</h1>
				{subtitle && <p class="article-page__subtitle">{subtitle}</p>}
				<div class="article-page__meta">
					<time datetime={pubDate.toISOString().slice(0, 10)}>{dateFormat.format(pubDate)}</time>
				</div>
			</header>
			{sections.length > 0 && (
				<div class="article-contents">
					<nav class="article-contents__sidebar" aria-label={contentsLabel}>
						<h2>{contentsLabel}</h2>
						<ol>{sections.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}</ol>
					</nav>
					<details class="article-contents__disclosure">
						<summary>{contentsLabel}</summary>
						<ol>{sections.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}</ol>
					</details>
				</div>
			)}
			<div class="article-page__content">
				{cover && <div class="article-page__hero"><img src={cover.src} alt={cover.alt} /></div>}
				<div class="article-prose">
					<Content />
				</div>
			</div>
		</article>
	</main>
	<Footer />
</Layout>

<style>
	.article-layout {
		display: grid;
		grid-template-columns: minmax(0, 840px);
		justify-content: center;
	}

	.article-contents {
		margin-bottom: 2rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-card);
	}

	.article-contents__sidebar {
		display: none;
		padding: 1.25rem;
	}

	.article-contents h2,
	.article-contents summary {
		margin: 0;
		font-size: 1rem;
		font-weight: 700;
	}

	.article-contents summary {
		padding: 0.85rem 1.25rem;
		cursor: pointer;
	}

	.article-contents ol {
		display: grid;
		gap: 0.25rem;
		margin: 0.6rem 0 0;
		padding-left: 1.25rem;
		color: var(--color-muted-foreground);
		font-size: 0.9rem;
	}

	.article-contents__disclosure ol {
		margin: 0 1.25rem 0.85rem;
	}

	.article-contents a {
		display: block;
		padding: 0.35rem 0 0.35rem 0.15rem;
		color: var(--color-foreground);
		line-height: 1.45;
		text-decoration: none;
		text-underline-offset: 0.2em;
	}

	.article-contents a:hover,
	.article-contents a:focus-visible {
		color: var(--color-primary);
		text-decoration: underline;
	}

	.article-prose :global(h2[id]) {
		scroll-margin-top: 1.5rem;
	}

	.article-page__subtitle {
		max-inline-size: 64ch;
		margin: 0 0 1rem;
		padding: clamp(0.8rem, 2.3vw, 1.2rem) clamp(0.95rem, 3vw, 1.4rem);
		border: 1px solid var(--color-border);
		border-inline-start: 3px solid var(--color-primary);
		border-radius: var(--radius-md);
		background: linear-gradient(110deg, var(--color-accent), var(--color-card) 92%);
		color: var(--color-foreground);
		font-size: clamp(1.05rem, 2.25vw, 1.25rem);
		font-weight: 500;
		line-height: 1.55;
		text-wrap: pretty;
	}

	.article-prose :global(.article-term),
	.article-prose :global(.article-task),
	.article-prose :global(.article-takeaway) {
		padding: clamp(1.1rem, 3vw, 1.75rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}

	.article-prose :global(.article-term) {
		margin: 1rem 0 1.5rem;
		border-inline-start: 3px solid var(--color-primary);
		background: var(--color-card);
	}

	.article-prose :global(.article-term__label) {
		color: var(--color-primary);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.article-prose :global(.article-term h3) {
		margin: 0.3rem 0 0.5rem;
		font-size: 1.15rem;
	}

	.article-prose :global(.article-term p) {
		margin: 0;
		font-size: 1rem;
		line-height: 1.65;
	}

	.article-prose :global(.article-task) {
		margin-bottom: 2rem;
		background: linear-gradient(120deg, var(--color-accent), var(--color-card) 85%);
	}

	.article-prose :global(.article-task p) {
		margin: 0;
		color: var(--color-foreground);
		line-height: 1.65;
	}

	.article-prose :global(.article-takeaway) {
		margin-top: 2rem;
		background: var(--color-card);
	}

	.article-prose :global(.article-task h2),
	.article-prose :global(.article-takeaway h2) {
		margin: 0 0 1rem;
		padding-inline-start: 0.8rem;
		border-inline-start: 3px solid var(--color-primary);
		color: var(--color-foreground);
		font-size: clamp(1.5rem, 3.5vw, 1.85rem);
		font-weight: 750;
	}

	.article-prose :global(.article-takeaway ol) {
		margin: 0;
		padding: 0;
	}

	.article-prose :global(.article-takeaway li) {
		margin: 0;
		padding: 0.65rem 0.85rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-background);
		color: var(--color-foreground);
		font-weight: 500;
		line-height: 1.5;
		list-style-position: inside;
	}

	.article-prose :global(.article-takeaway li::marker) {
		color: var(--color-primary);
		font-weight: 700;
	}

	.article-prose :global(.article-takeaway li + li) {
		margin-top: 0.55rem;
	}

	.article-prose :global(table) {
		width: 100%;
		table-layout: fixed;
		border-collapse: collapse;
		font-size: 0.95rem;
		line-height: 1.55;
	}

	.article-prose :global(th),
	.article-prose :global(td) {
		padding: 0.6rem;
		border: 1px solid var(--color-border);
		text-align: left;
		vertical-align: top;
		overflow-wrap: anywhere;
	}

	.article-prose :global(th) {
		background: var(--color-accent);
	}

	@media (min-width: 1024px) {
		.article-layout--with-contents {
			grid-template-columns: minmax(0, 15rem) minmax(0, 840px);
			column-gap: clamp(2rem, 4vw, 3.5rem);
		}

		.article-layout--with-contents > .article-page__header,
		.article-layout--with-contents > .article-page__content {
			grid-column: 2;
		}

		.article-contents {
			position: sticky;
			top: 1.5rem;
			grid-column: 1;
			grid-row: 1 / span 2;
			align-self: start;
			max-height: calc(100dvh - 3rem);
			margin-bottom: 0;
			overflow-y: auto;
		}

		.article-contents__sidebar {
			display: block;
		}

		.article-contents__disclosure {
			display: none;
		}
	}
</style>
