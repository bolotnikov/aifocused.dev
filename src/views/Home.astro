---
import type { CollectionEntry } from 'astro:content';
import Footer from '../components/common/Footer.astro';
import Header from '../components/common/Header.astro';
import { Locale } from '../i18n/Locale';
import Layout from '../layouts/Layout.astro';

interface Props {
	articles: CollectionEntry<'articles'>[];
}

const { articles } = Astro.props;
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
const dateFormat = new Intl.DateTimeFormat(i18n.dateLocale, { dateStyle: 'long', timeZone: 'UTC' });
---

<Layout>
	<Header />
	<main class="page-main page-main--home">
		<div class="container">
			<header class="home-intro">
				<h1>{t('home.title')}</h1>
				<p>{t('home.description')}</p>
			</header>
			{articles.length > 0 && (
				<div class="article-list" id="articles-title">
					{articles.map(({ data }) => {
						const preview = data.preview ?? data.cover;
						const titleId = `article-${data.translationKey}-title`;
						return (
							<article class="article-card">
								<a class="article-card__link" href={i18n.path(`/articles/${data.translationKey}/`)} aria-labelledby={titleId}>
									<div class="article-card__body">
										<time class="article-card__date" datetime={data.pubDate.toISOString().slice(0, 10)}>{dateFormat.format(data.pubDate)}</time>
										<h2 id={titleId}>{data.cardTitle ?? data.title}</h2>
										<p>{data.description}</p>
										<span class="article-card__action" aria-hidden="true">{t('home.readArticle')}</span>
									</div>
									{preview && (
										<div class="article-card__media">
											<img src={preview.src} alt={preview.alt} decoding="async" />
										</div>
									)}
								</a>
							</article>
						);
					})}
				</div>
			)}
		</div>
	</main>
	<Footer />
</Layout>
