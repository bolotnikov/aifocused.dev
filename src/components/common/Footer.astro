---
import { Locale } from '../../i18n/Locale';
import AnalyticsConsent from './AnalyticsConsent.astro';
const i18n = Locale.forPath(Astro.url.pathname);
const t = i18n.t.bind(i18n);
---
<footer class="site-footer">
	<div class="container footer-row">
		<a class="brand-wordmark" href={i18n.path('/')}>AIFocused<span>.dev</span></a>
		<div class="footer-links">
			<a href={i18n.path('/about/')}>{t('About')}</a>
			<a href={`${i18n.path('/about/')}#contact`}>{t('Contact')}</a>
			{import.meta.env.PROD && <AnalyticsConsent />}
		</div>
	</div>
</footer>
