---
import { Locale } from '../../i18n/Locale';

const i18n = Locale.forPath(Astro.url.pathname);
---

<div data-analytics-consent="G-BKSK007KT9">
	<button type="button" class="preferences" aria-controls="analytics-preferences" aria-expanded="false" hidden>
		{i18n.t('Analytics preferences')}
	</button>
	<section id="analytics-preferences" class="panel" aria-labelledby="analytics-title" hidden>
		<h2 id="analytics-title">{i18n.t('Analytics preferences')}</h2>
		<p>{i18n.t('Google Analytics uses cookies to measure visits and page views. If you allow analytics, your browser shares usage data with Google. You can change your choice here at any time.')}</p>
		<a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer">
			{i18n.t('How Google uses this data')}
		</a>
		<div class="choices">
			<button type="button" data-allow>{i18n.t('Allow analytics')}</button>
			<button type="button" data-decline>{i18n.t('Decline analytics')}</button>
		</div>
	</section>
</div>

<script>
	const root = document.querySelector<HTMLElement>('[data-analytics-consent]');
	const id = root?.dataset.analyticsConsent;
	const panel = root?.querySelector<HTMLElement>('.panel');
	const preferences = root?.querySelector<HTMLButtonElement>('.preferences');
	const allow = root?.querySelector<HTMLButtonElement>('[data-allow]');
	const decline = root?.querySelector<HTMLButtonElement>('[data-decline]');

	if (id && panel && preferences && allow && decline) {
		const storageKey = 'aifocused:analytics-consent:v1';
		const analyticsWindow: Window & { dataLayer?: IArguments[] } = window;
		const disableKey = `ga-disable-${id}`;
		let loaded = false;
		let choice: string | null = null;
		try { choice = localStorage.getItem(storageKey); }
		catch { /* The visitor can still choose for the current page. */ }

		const enableAnalytics = () => {
			Object.assign(analyticsWindow, { [disableKey]: false });
			if (loaded) return;
			loaded = true;
			const dataLayer = analyticsWindow.dataLayer ??= [];
			const gtag: (...command: [string, ...unknown[]]) => void = function () {
				// eslint-disable-next-line prefer-rest-params -- The Google tag expects its standard arguments object.
				dataLayer.push(arguments);
			};
			gtag('consent', 'default', {
				ad_storage: 'denied',
				ad_user_data: 'denied',
				ad_personalization: 'denied',
				analytics_storage: 'denied',
			});
			gtag('consent', 'update', { analytics_storage: 'granted' });
			gtag('js', new Date());
			gtag('config', id, { allow_google_signals: false, allow_ad_personalization_signals: false });
			const script = document.createElement('script');
			script.async = true;
			script.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
			document.head.append(script);
		};

		const disableAnalytics = () => {
			Object.assign(analyticsWindow, { [disableKey]: true });
			for (const cookie of ['_ga', `_ga_${id.slice(2)}`]) {
				const expired = `${cookie}=; Path=/; Max-Age=0`;
				document.cookie = expired;
				document.cookie = `${expired}; Domain=${location.hostname}`;
			}
		};

		const showPanel = (open: boolean) => {
			panel.hidden = !open;
			preferences.setAttribute('aria-expanded', String(open));
		};
		const saveChoice = (value: 'granted' | 'denied') => {
			try { localStorage.setItem(storageKey, value); }
			catch { /* The current page still honors the choice. */ }
			if (value === 'granted') enableAnalytics();
			else disableAnalytics();
			showPanel(false);
			preferences.focus();
		};

		preferences.hidden = false;
		showPanel(choice !== 'granted' && choice !== 'denied');
		if (choice === 'granted') enableAnalytics();
		preferences.addEventListener('click', () => {
			showPanel(panel.hidden);
			if (!panel.hidden) allow.focus();
		});
		allow.addEventListener('click', () => saveChoice('granted'));
		decline.addEventListener('click', () => saveChoice('denied'));
	}
</script>

<style>
	.preferences {
		padding: 0;
		border: 0;
		background: transparent;
		color: inherit;
		cursor: pointer;
	}
	.preferences:hover { text-decoration: underline; }
	.panel {
		position: fixed;
		z-index: 20;
		inset-inline-end: 1rem;
		bottom: 1rem;
		width: min(28rem, calc(100% - 2rem));
		padding: 1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-card);
		color: var(--color-card-foreground);
		box-shadow: var(--shadow-card);
	}
	.panel h2 { margin: 0; font-size: 1rem; }
	.panel p { margin: 0.5rem 0; }
	.panel a { text-decoration: underline; }
	.choices { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
	.choices button {
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-secondary);
		color: var(--color-secondary-foreground);
		cursor: pointer;
	}
</style>
